# Same project as courses-website. No service-role/secret key is required.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Public HTTPS origin only. Canonical OAuth resource = this origin + /mcp.
MCP_PUBLIC_URL=https://courses-mcp.example.com
# Match your Supabase asymmetric signing key: ES256 or RS256.
MCP_JWT_ALGORITHM=ES256

# Per authenticated user: sustained requests/second and maximum burst.
MCP_RATE_LIMIT_PER_SECOND=5
MCP_RATE_LIMIT_BURST=15
